{
  "name": "algoarena-server",
  "version": "2.0.0",
  "private": true,
  "description": "AlgoArena API, match engine and judge: Node.js, Express, WebSockets (ws) and Prisma on PostgreSQL.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:judge": "node --test --test-concurrency=1 test/judge/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:sql": "node scripts/migration-sql.js",
    "seed": "node scripts/seed.js",
    "seed:check": "node scripts/seed-check.js",
    "gen:tests": "node scripts/gen-tests.js",
    "types": "node scripts/make-types.js",
    "types:check": "node scripts/make-types.js --check",
    "load-test": "node scripts/load-test.js",
    "lint": "node --check src/index.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^5.3.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "prisma": {
    "seed": "node scripts/seed.js"
  }
}
