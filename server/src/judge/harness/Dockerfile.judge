# Judge image: the language runtimes (Python, g++) plus the Node test harness, nothing else.
# The server's DockerRunner starts one container per job with --network none,
# --read-only, --cap-drop ALL, no-new-privileges, a pids limit, memory and CPU caps,
# and uid 65534. The job spec (source + tests, never expected outputs) arrives on stdin.
#   build: make judge-image   (docker build -t algoarena-judge:latest -f Dockerfile.judge .)
FROM node:22-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 g++ \
 && rm -rf /var/lib/apt/lists/*

COPY harness.js package.json /harness/
COPY include /harness/include
RUN chmod -R a+rX,a-w /harness

WORKDIR /tmp
USER 65534:65534
ENTRYPOINT []
CMD ["node", "/harness/harness.js"]
